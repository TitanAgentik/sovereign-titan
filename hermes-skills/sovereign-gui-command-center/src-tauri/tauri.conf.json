{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sovereign Titan OS",
  "version": "2.0.0",
  "identifier": "os.sovereigntitan.commandcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SOVEREIGN TITAN OS — Native Command Center (Threadripper PRO 9995WX · Cores 32–35)",
        "width": 1720,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
